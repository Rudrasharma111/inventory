{
  "info": {
    "name": "Inventory Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "HOW TO USE: 1) Run Auth > Signup once (creates the staff user). 2) Open Auth > Login > Body and put the email and password of the user you want (staff: staff@example.com / password123, admin: your ADMIN_EMAIL / ADMIN_PASSWORD from .env), then Send. That user is now ACTIVE: its token is used by EVERY request automatically. Change the body and Send again to switch user; the old token is replaced. The results (200 or 403) are the ones for the logged-in user. A login never creates anybody."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{activeToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Helps when the token is missing or expired (tokens last 60 minutes).",
          "if (pm.response.code === 401 && !pm.request.url.getPath().startsWith('/auth/')) {",
          "  console.log('401: not logged in or token expired. Run Auth > Login as Admin (or Login as Staff).');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup (staff user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul\",\n  \"email\": \"ab@gmail.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"Password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created or 409 already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ab@gmail.com\",\n  \"password\": \"Password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The user in the request body is logged in and becomes the ACTIVE user.",
                  "// Every other request uses this token automatically. Log in as someone else and it is replaced.",
                  "// Nothing is created here.",
                  "pm.test('Login: status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code !== 200) {",
                  "  console.log('Login failed: check the email and password in the request body.');",
                  "  return;",
                  "}",
                  "const me = pm.response.json();",
                  "pm.collectionVariables.set('activeToken', me.access_token);",
                  "pm.collectionVariables.set('activeRole', me.role);",
                  "pm.test('Now logged in as ' + me.role + ': this token is used for every request', () => pm.expect(me.token_type).to.eql('bearer'));",
                  "console.log('Active user: ' + me.role);"
                ]
              }
            }
          ]
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "google"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"{{googleIdToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Needs a real Google ID token in the googleIdToken variable",
                  "pm.test('200 with a valid Google token; 401/409/422/503 when the token is empty, invalid or Google is not configured', () => pm.expect([200, 401, 409, 422, 503]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Items",
      "item": [
        {
          "name": "Create Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Keyboard\",\n  \"quantity\": 10,\n  \"price\": 2000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('itemId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Items (pagination + search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items?page=1&limit=5&search=key",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "search",
                  "value": "key"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has pagination fields', () => pm.expect(pm.response.json()).to.have.keys('page', 'limit', 'total', 'items'));",
                  "pm.test('has X-Process-Time header (added by a middleware)', () => pm.response.to.have.header('X-Process-Time'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Item",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "{{itemId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "{{itemId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Keyboard\",\n  \"quantity\": 25,\n  \"price\": 5000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Quantity updated', () => pm.expect(pm.response.json().quantity).to.eql(25));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Item (admin/manager 200, staff 403)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "{{itemId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Makes sure an item exists to delete (creates one with the active user if needed).",
                  "const base = pm.collectionVariables.get('baseUrl');",
                  "const h = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.collectionVariables.get('activeToken') };",
                  "const id = pm.collectionVariables.get('itemId');",
                  "pm.sendRequest({ url: base + '/items/' + (id || 0), method: 'GET', header: h }, (e, r) => {",
                  "  if (!e && r.code === 200) return;",
                  "  pm.sendRequest({ url: base + '/items', method: 'POST', header: h,",
                  "    body: { mode: 'raw', raw: JSON.stringify({ name: 'Keyboard', quantity: 10, price: 5000 }) } }, (e2, r2) => {",
                  "    if (!e2 && r2.code === 201) pm.collectionVariables.set('itemId', r2.json().id);",
                  "  });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The result depends on WHO is logged in (the active user).",
                  "const role = pm.collectionVariables.get('activeRole');",
                  "const base = pm.collectionVariables.get('baseUrl');",
                  "const id = pm.collectionVariables.get('itemId');",
                  "const h = { 'Authorization': 'Bearer ' + pm.collectionVariables.get('activeToken') };",
                  "if (['admin', 'inventory_manager'].includes(role)) {",
                  "  pm.test(role + ' can delete (200 + message)', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().message).to.include('deleted'); });",
                  "  pm.sendRequest({ url: base + '/items/' + id, method: 'GET', header: h }, (e, r) => {",
                  "    pm.test('Deleted item is gone (404)', () => pm.expect(r.code).to.eql(404));",
                  "  });",
                  "} else {",
                  "  pm.test(role + ' cannot delete (403)', () => pm.response.to.have.status(403));",
                  "  pm.sendRequest({ url: base + '/items/' + id, method: 'GET', header: h }, (e, r) => {",
                  "    pm.test('Item is still there (200)', () => pm.expect(r.code).to.eql(200));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users (admin 200, staff 403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const role = pm.collectionVariables.get('activeRole');",
                  "if (role === 'admin') {",
                  "  pm.test('Admin can list users (200)', () => pm.response.to.have.status(200));",
                  "  const users = pm.response.code === 200 ? pm.response.json() : [];",
                  "  const staff = users.find(u => u.email === String(pm.collectionVariables.get('staffEmail')).toLowerCase());",
                  "  pm.test('Users have no password_hash', () => users.forEach(u => pm.expect(u).to.not.have.property('password_hash')));",
                  "  if (staff) pm.collectionVariables.set('userId', staff.id);",
                  "} else {",
                  "  pm.test(role + ' cannot list users (403)', () => pm.response.to.have.status(403));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Change User Role (admin: manager, 422, staff | others 403)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "role"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"inventory_manager\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Admin: finds the staff user's id, so this request works even when sent alone.",
                  "// Others cannot list users, so any valid id is used and the server answers 403.",
                  "if (pm.collectionVariables.get('activeRole') !== 'admin') {",
                  "  if (!pm.collectionVariables.get('userId')) pm.collectionVariables.set('userId', '1');",
                  "} else {",
                  "  pm.sendRequest({ url: pm.collectionVariables.get('baseUrl') + '/users',",
                  "    header: { 'Authorization': 'Bearer ' + pm.collectionVariables.get('activeToken') } }, (e, r) => {",
                  "    if (!e && r.code === 200) {",
                  "      const s = r.json().find(u => u.email === String(pm.collectionVariables.get('staffEmail')).toLowerCase());",
                  "      if (s) pm.collectionVariables.set('userId', s.id);",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const role = pm.collectionVariables.get('activeRole');",
                  "const base = pm.collectionVariables.get('baseUrl');",
                  "const path = '/users/' + pm.collectionVariables.get('userId') + '/role';",
                  "const send = (body, done) => pm.sendRequest({ url: base + path, method: 'PATCH',",
                  "  header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.collectionVariables.get('activeToken') },",
                  "  body: { mode: 'raw', raw: JSON.stringify(body) } }, done);",
                  "if (role === 'admin') {",
                  "  pm.test('Staff user exists (run Auth > Signup first if this fails)', () => pm.expect(pm.collectionVariables.get('userId')).to.not.be.oneOf([undefined, null, '']));",
                  "  pm.test('Admin can make a user inventory_manager (200)', () => pm.response.to.have.status(200));",
                  "  pm.test('Role is inventory_manager', () => pm.expect(pm.response.json().role).to.eql('inventory_manager'));",
                  "  send({ role: 'admin' }, (e, r) => pm.test('Nobody can be made admin (422)', () => pm.expect(r.code).to.eql(422)));",
                  "  send({ role: 'staff' }, (e, r) => pm.test('User is staff again (200)', () => { pm.expect(r.code).to.eql(200); pm.expect(r.json().role).to.eql('staff'); }));",
                  "} else {",
                  "  pm.test(role + ' cannot change roles (403)', () => pm.response.to.have.status(403));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "staffEmail",
      "value": "staff@example.com"
    },
    {
      "key": "staffPassword",
      "value": "password123"
    },
    {
      "key": "googleIdToken",
      "value": ""
    },
    {
      "key": "activeToken",
      "value": ""
    },
    {
      "key": "activeRole",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ]
}