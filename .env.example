# Copy this file to .env and fill in the values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/inventory_db

# Admin account: created (or reset) from these values on every startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Optional: websites allowed to call the API from a browser (comma separated)
CORS_ORIGINS=http://localhost:3000

# Optional: only for "Sign in with Google" (see README, section Google login)
GOOGLE_CLIENT_ID=
